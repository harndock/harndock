{
  "name": "@harndock/sync-protocol",
  "version": "0.1.0",
  "description": "Versioned protocol types and schemas for harndock remote sync",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schemas/frame.schema.json": "./schemas/frame.schema.json",
    "./test-vectors/*": "./test-vectors/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "test-vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
