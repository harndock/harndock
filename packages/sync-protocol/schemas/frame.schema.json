{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harndock.com/schemas/sync-frame-v1.json",
  "title": "harndock remote sync protocol frame v1",
  "oneOf": [
    { "$ref": "#/$defs/clientHello" },
    { "$ref": "#/$defs/serverHello" },
    { "$ref": "#/$defs/pcChallenge" },
    { "$ref": "#/$defs/pcRegister" },
    { "$ref": "#/$defs/pcRegistered" },
    { "$ref": "#/$defs/pcHeartbeat" },
    { "$ref": "#/$defs/clientSubscribe" },
    { "$ref": "#/$defs/clientUnsubscribe" },
    { "$ref": "#/$defs/cursorResume" },
    { "$ref": "#/$defs/eventAck" },
    { "$ref": "#/$defs/sessionSnapshot" },
    { "$ref": "#/$defs/sessionEvent" },
    { "$ref": "#/$defs/commandSubmit" },
    { "$ref": "#/$defs/commandStatus" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "base": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sentAt"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "accountId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "sessionId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "platform": {
      "enum": ["ios", "android", "web", "macos", "windows", "linux"]
    },
    "agentPresetId": {
      "enum": ["harness", "codex", "claude-code"]
    },
    "agentSessionStatus": {
      "enum": ["idle", "running", "waiting", "completed", "failed", "cancelled", "offline"]
    },
    "agentSchemaVersion": {
      "const": 1
    },
    "nativeSessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "agentPreset", "nativeSessionId", "resumeReference"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/agentSchemaVersion" },
        "agentPreset": { "$ref": "#/$defs/agentPresetId" },
        "nativeSessionId": { "$ref": "#/$defs/id" },
        "resumeReference": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^ref:[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$" }
          ]
        }
      }
    },
    "agentCapabilityFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create", "resume", "send", "stream", "cancel", "approval", "toolEvents", "usage",
        "modelSelection", "accessMode", "childTasks", "plugins", "mcp", "skills", "hooks", "remotePrompt"
      ],
      "properties": {
        "create": { "type": "boolean" },
        "resume": { "type": "boolean" },
        "send": { "type": "boolean" },
        "stream": { "type": "boolean" },
        "cancel": { "type": "boolean" },
        "approval": { "type": "boolean" },
        "toolEvents": { "type": "boolean" },
        "usage": { "type": "boolean" },
        "modelSelection": { "type": "boolean" },
        "accessMode": { "type": "boolean" },
        "childTasks": { "type": "boolean" },
        "plugins": { "type": "boolean" },
        "mcp": { "type": "boolean" },
        "skills": { "type": "boolean" },
        "hooks": { "type": "boolean" },
        "remotePrompt": { "type": "boolean" }
      }
    },
    "agentDisabledReasons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "resume": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "send": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "stream": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "cancel": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "approval": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "toolEvents": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "usage": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "modelSelection": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "accessMode": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "childTasks": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "plugins": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "mcp": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "skills": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "hooks": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "remotePrompt": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "agentCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "preset", "capabilities", "disabledReasons", "observedAt", "adapterVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/agentSchemaVersion" },
        "preset": { "$ref": "#/$defs/agentPresetId" },
        "capabilities": { "$ref": "#/$defs/agentCapabilityFlags" },
        "disabledReasons": { "$ref": "#/$defs/agentDisabledReasons" },
        "observedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nativeProtocolVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "baseProperties": {
      "protocolVersion": { "const": 1 },
      "frameId": { "$ref": "#/$defs/id" },
      "accountId": { "$ref": "#/$defs/id" },
      "deviceId": { "$ref": "#/$defs/id" },
      "runtimeId": { "$ref": "#/$defs/id" },
      "sessionId": { "$ref": "#/$defs/id" },
      "sentAt": { "$ref": "#/$defs/timestamp" }
    },
    "clientHello": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "client.hello" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supportedVersions", "client"],
          "properties": {
            "supportedVersions": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
            "client": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "platform", "capabilities"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                "version": { "type": "string", "minLength": 1, "maxLength": 64 },
                "platform": { "$ref": "#/$defs/platform" },
                "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
              }
            }
          }
        }
      }
    },
    "serverHello": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "server.hello" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connectionId", "negotiatedVersion", "heartbeatIntervalMs", "serverTime"],
          "properties": {
            "connectionId": { "$ref": "#/$defs/id" },
            "negotiatedVersion": { "const": 1 },
            "heartbeatIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
            "serverTime": { "$ref": "#/$defs/timestamp" }
          }
        }
      }
    },
    "pcRegister": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "accountId", "deviceId", "runtimeId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "pc.register" },
        "accountId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["challengeId", "signature", "publicKey", "profile", "runtimeVersion", "runtimeApi", "harnessCommit", "capabilities"],
          "properties": {
            "challengeId": { "$ref": "#/$defs/id" },
            "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{40,256}$" },
            "publicKey": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "profile": { "const": "desktop" },
            "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "runtimeApi": { "type": "integer", "minimum": 1 },
            "harnessCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
          }
        }
      }
    },
    "pcChallenge": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "deviceId", "runtimeId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "pc.challenge" },
        "deviceId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["challengeId", "nonce", "expiresAt"],
          "properties": {
            "challengeId": { "$ref": "#/$defs/id" },
            "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,256}$" },
            "expiresAt": { "$ref": "#/$defs/timestamp" }
          }
        }
      }
    },
    "pcRegistered": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "accountId", "deviceId", "runtimeId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "pc.registered" },
        "accountId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptedAt"],
          "properties": { "acceptedAt": { "$ref": "#/$defs/timestamp" } }
        }
      }
    },
    "pcHeartbeat": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "accountId", "deviceId", "runtimeId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "pc.heartbeat" },
        "accountId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "lastSeqBySession"],
          "properties": {
            "status": { "enum": ["online", "degraded"] },
            "lastSeqBySession": { "type": "object", "additionalProperties": { "type": "integer", "minimum": -1 } }
          }
        }
      }
    },
    "clientSubscribe": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sessionId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "client.subscribe" },
        "sessionId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fromSeq": { "type": "integer", "minimum": 0 },
            "includeSnapshot": { "type": "boolean" }
          }
        }
      }
    },
    "clientUnsubscribe": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sessionId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "client.unsubscribe" },
        "sessionId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "cursorResume": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sessionId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "cursor.resume" },
        "sessionId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lastSeq"],
          "properties": { "lastSeq": { "type": "integer", "minimum": -1 } }
        }
      }
    },
    "eventAck": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sessionId", "seq", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "event.ack" },
        "sessionId": { "$ref": "#/$defs/id" },
        "seq": { "type": "integer", "minimum": -1 },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ackedFrameId"],
          "properties": { "ackedFrameId": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "sessionSnapshot": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "accountId", "deviceId", "runtimeId", "sessionId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "session.snapshot" },
        "accountId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "sessionId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["header", "projection"],
          "properties": {
            "header": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "createdAt", "parentSessionId"],
              "properties": {
                "schemaVersion": { "$ref": "#/$defs/agentSchemaVersion" },
                "title": { "type": "string", "maxLength": 4096 },
                "cwdLabel": { "type": "string", "maxLength": 256 },
                "workspaceId": { "$ref": "#/$defs/id" },
                "agentPreset": { "$ref": "#/$defs/agentPresetId" },
                "nativeRef": { "$ref": "#/$defs/nativeSessionRef" },
                "createdAt": { "type": "integer", "minimum": 0 },
                "updatedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "lastSeq": { "type": "integer", "minimum": -1, "maximum": 9007199254740991 },
                "status": { "$ref": "#/$defs/agentSessionStatus" },
                "parentSessionId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
              }
            },
            "projection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "lastSeq", "lastActivityAt", "unresolvedApproval"],
              "properties": {
                "status": { "enum": ["idle", "running", "waiting", "completed", "failed", "cancelled", "offline"] },
                "lastSeq": { "type": "integer", "minimum": -1 },
                "lastActivityAt": { "type": "integer", "minimum": 0 },
                "unresolvedApproval": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["approvalId", "toolName"],
                      "properties": {
                        "approvalId": { "$ref": "#/$defs/id" },
                        "toolName": { "type": "string", "minLength": 1, "maxLength": 256 }
                      }
                    },
                    { "type": "null" }
                  ]
                },
                "capabilities": { "$ref": "#/$defs/agentCapabilities" }
              }
            }
          }
        }
      }
    },
    "sessionEvent": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "accountId", "deviceId", "runtimeId", "sessionId", "seq", "eventType", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "session.event" },
        "accountId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "sessionId": { "$ref": "#/$defs/id" },
        "seq": { "type": "integer", "minimum": 0 },
        "eventType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": {
              "type": "object",
              "required": ["type", "seq", "time", "data"],
              "properties": {
                "type": { "type": "string", "minLength": 1, "maxLength": 256 },
                "seq": { "type": "integer", "minimum": 0 },
                "time": { "type": "integer", "minimum": 0 },
                "data": {}
              }
            }
          }
        }
      }
    },
    "commandSubmit": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sessionId", "commandId", "baseSeq", "commandType", "expiresAt", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "command.submit" },
        "sessionId": { "$ref": "#/$defs/id" },
        "commandId": { "$ref": "#/$defs/id" },
        "baseSeq": { "type": "integer", "minimum": -1 },
        "commandType": { "enum": ["session.prompt", "session.cancel", "approval.respond"] },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contentBlocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "text"],
                "properties": {
                  "type": { "const": "text" },
                  "text": { "type": "string", "minLength": 1, "maxLength": 100000 }
                }
              }
            },
            "approvalId": { "$ref": "#/$defs/id" },
            "outcome": { "enum": ["allowed-once", "rejected"] }
          }
        }
      }
    },
    "commandStatus": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sessionId", "commandId", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "command.status" },
        "sessionId": { "$ref": "#/$defs/id" },
        "commandId": { "$ref": "#/$defs/id" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["received", "authorized", "queued", "executing", "completed", "rejected", "expired", "unknown"] },
            "reason": { "type": "string", "maxLength": 4096 },
            "acceptedAt": { "$ref": "#/$defs/timestamp" },
            "completedAt": { "$ref": "#/$defs/timestamp" }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["protocolVersion", "frameId", "kind", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "frameId": { "$ref": "#/$defs/id" },
        "kind": { "const": "error" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "enum": ["authentication_required", "authorization_denied", "device_revoked", "protocol_version_unsupported", "cursor_gap", "stale_state", "duplicate_command", "runtime_offline", "command_expired", "approval_already_decided", "invalid_frame", "rate_limited"] },
            "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "retryable": { "type": "boolean" },
            "details": { "type": "object", "additionalProperties": true }
          }
        }
      }
    }
  }
}
