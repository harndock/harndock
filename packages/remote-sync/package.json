{
  "name": "@harndock/remote-sync",
  "version": "0.1.0",
  "description": "Read-only PC connector for harndock remote synchronization",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@harndock/sync-protocol": "workspace:*",
    "@types/node": "22.15.21",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "typescript": "5.8.3"
  }
}
